# Copiá este archivo como .env y completá los valores.
# Todo es opcional: lo que no definas usa el valor por defecto indicado.

# ── Seguridad ────────────────────────────────────────────────────────────────
# Clave para firmar los tokens de sesión (JWT). Usá una larga y aleatoria, por ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambiás en una instalación que ya está en uso, todas las sesiones abiertas
# se cierran (los usuarios tienen que volver a iniciar sesión). No se pierde nada más.
SECRET_KEY=

# Duración de la sesión en minutos (por defecto 1440 = 1 día)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma.
# El frontend ya se sirve desde la misma app, así que normalmente no hace falta:
# dejalo vacío para desactivar CORS. Por defecto: *
CORS_ORIGINS=

# ── Admin inicial ────────────────────────────────────────────────────────────
# Solo se usan al crear una base nueva (usuario: admin).
# Si no definís ADMIN_PASSWORD se usa "admin123" y se pide cambiarla en el primer login.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@gezarma.local

# ── Zona horaria ─────────────────────────────────────────────────────────────
# Zona del negocio (nombre IANA). Las fechas se guardan en UTC y cada navegador
# las muestra en su hora local; esta zona se usa para las exportaciones y para
# convertir a UTC las fechas viejas que estaban en hora local (se hace una sola
# vez, al actualizar). Si tu servidor estaba configurado en otra zona, ponela acá
# ANTES de actualizar. Por defecto: America/Argentina/Buenos_Aires
TIMEZONE=America/Argentina/Buenos_Aires

# ── URL pública ──────────────────────────────────────────────────────────────
# Dirección con la que se accede al sistema desde afuera. Se usa en los QR y en
# los links de los mails. También se puede cargar en Administración → Ajustes.
# Vacía = la dirección con la que se está usando el sistema.
PUBLIC_URL=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Se usa si en Administración → Ajustes elegís "Archivo .env" como origen de la
# configuración SMTP (la otra opción es cargarla en el panel).
# Las notificaciones se activan y eligen desde ese mismo panel.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | ninguna
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Remitente, ej.: GEZARMA <rma@tuempresa.com>. Vacío = SMTP_USER
SMTP_FROM=

# ── Datos ────────────────────────────────────────────────────────────────────
# Base de datos (por defecto SQLite en el directorio desde donde se ejecuta).
# Ejemplo PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/gezarma
DATABASE_URL=sqlite:///./rma_system.db

# Carpeta de adjuntos (por defecto ./uploads)
UPLOAD_DIR=uploads
