# Copiá este archivo como .env y completá los valores.
# Todo es opcional: lo que no definas usa el valor por defecto indicado.

# ── Seguridad ────────────────────────────────────────────────────────────────
# Clave para firmar los tokens de sesión (JWT). Usá una larga y aleatoria, por ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambiás en una instalación que ya está en uso, todas las sesiones abiertas
# se cierran (los usuarios tienen que volver a iniciar sesión). No se pierde nada más.
SECRET_KEY=

# Duración de la sesión en minutos (por defecto 1440 = 1 día)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma.
# El frontend ya se sirve desde la misma app, así que normalmente no hace falta:
# dejalo vacío para desactivar CORS. Por defecto: *
CORS_ORIGINS=

# ── Admin inicial ────────────────────────────────────────────────────────────
# Solo se usan al crear una base nueva (usuario: admin).
# Si no definís ADMIN_PASSWORD se usa "admin123" y se pide cambiarla en el primer login.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@gezatek.com.ar

# ── Datos ────────────────────────────────────────────────────────────────────
# Base de datos (por defecto SQLite en el directorio desde donde se ejecuta).
# Ejemplo PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/gezarma
DATABASE_URL=sqlite:///./rma_system.db

# Carpeta de adjuntos (por defecto ./uploads)
UPLOAD_DIR=uploads
